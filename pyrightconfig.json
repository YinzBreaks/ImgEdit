{
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "**/node_modules",
    "**/.*",
    "**/__pycache__",
    ".venv",
    "venv",
    "build",
    "dist",
    "reports",
    "out"
  ],
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.10",
  "typeCheckingMode": "strict",
  "reportMissingTypeStubs": "none"
}
